# SYNTHETIC / DEMO DATA — NOT REAL PATIENT INFORMATION
# Copy to .env and fill in for local development. Never commit the real .env.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-32-bytes-minimum-random-value
SESSION_COOKIE_NAME=rpm_session
SESSION_TTL_MINUTES=60

# --- Database ---
POSTGRES_USER=rpm_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rpm_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rpm_app:change-me@db:5432/rpm_platform

# --- Field-level encryption (AES-256-GCM envelope key, prototype key mgmt only) ---
# 32-byte key, base64-encoded. Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Realtime (Section 41) ---
REALTIME_TRANSPORT=sse
REALTIME_MAX_CONNECTIONS_PER_USER=3
REALTIME_MESSAGE_RATE_LIMIT=20

# --- Quantum module ---
QUANTUM_MAX_QUBITS=6
QUANTUM_MAX_SHOTS=1024
QUANTUM_JOB_TIMEOUT_SECONDS=30
QUANTUM_JOBS_PER_USER_PER_MINUTE=3

# --- Synthetic data generator ---
SYNTHETIC_DATA_SEED=42
SYNTHETIC_DEVICE_INTERVAL_SECONDS=120

# --- CORS (dev only) ---
FRONTEND_ORIGIN=http://localhost:5173
